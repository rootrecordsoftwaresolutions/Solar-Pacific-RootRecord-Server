[Unit]
Description=RootRecord rootserver poller (5s heartbeat + Cloudflare tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rootrecord/.ollama/skills/automations
ExecStart=/home/rootrecord/.ollama/skills/automations/scripts/run-poller.sh
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=POLLER_ENABLE_TUNNEL=1
Environment=POLLER_TUNNEL_MODE=token
Environment=CLOUDFLARED_TOKEN_FILE=/home/rootrecord/.cloudflared/rootserver.token
StandardOutput=append:/home/rootrecord/.ollama/skills/logs/store/rootserver-poller.log
StandardError=append:/home/rootrecord/.ollama/skills/logs/store/rootserver-poller.log

[Install]
WantedBy=default.target
