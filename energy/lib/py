#!/usr/bin/env bash
# energy lib — one owner path for venv python + vendor PYTHONPATH
# Usage: lib/py script.py [args...]   or ENERGY_PYTHON=... lib/py ...
set -euo pipefail
ROOT="/home/rootrecord/.ollama/skills/energy"
VENDOR="$ROOT/lib/vendor"
export PYTHONPATH="${VENDOR}${PYTHONPATH:+:$PYTHONPATH}"
PY="${ENERGY_PYTHON:-$ROOT/.venv/bin/python}"
if [[ ! -x "$PY" ]]; then
  echo "WAITING / No data — energy python missing: $PY" >&2
  exit 2
fi
exec "$PY" "$@"
