[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = git@github.com:rootrecordsoftwaresolutions/Solar-Pacific-RootRecord-Server.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	pushurl = git@github.com:rootrecordsoftwaresolutions/Solar-Pacific-RootRecord-Server.git
[branch "main"]
	remote = backup
	merge = refs/heads/main
[remote "backup"]
	url = git@github.com:rootrecordsoftwaresolutions/Solar-Pacific-RootRecord-Server.git
	fetch = +refs/heads/*:refs/remotes/backup/*
